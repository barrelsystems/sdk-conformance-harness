{
  "name": "@barrel-kit/sdk-conformance-harness",
  "version": "0.0.1",
  "description": "Shared conformance test harness for Barrel's per-platform SDKs.",
  "bin": {
    "sdk-conformance-harness": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --disable-nested-config --max-warnings=0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "unused": "knip"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.4",
    "commander": "^15.1.0",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "knip": "^6.48.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "rolldown"
    ]
  }
}
